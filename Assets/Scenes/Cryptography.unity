--- !u!114 &1944068154
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1944068152}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Russian
    Text: "\u0428\u0438\u0444\u0440 \u0426\u0435\u0437\u0430\u0440\u044F \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D
      \u043A\u0430\u043A \u0434\u0432\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
      \u043A\u043E\u043B\u044C\u0446\u0430: \u0432\u043D\u0435\u0448\u043D\u0435\u0435
      \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0430\u043B\u0444\u0430\u0432\u0438\u0442\u043D\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435
      \u043D\u0430 \u0437\u0430\u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u043B\u044E\u0447
      k. \u041F\u0440\u0438 \u0434\u0435\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0438
      \u043A\u0430\u0436\u0434\u0430\u044F \u0431\u0443\u043A\u0432\u0430 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
      \u043A\u043E\u043B\u044C\u0446\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0431\u0443\u043A\u0432\u0435."
    Object: {fileID: 0}
  - Language: Turkish
    Text: "Sezar \u015Fifresi birbiriyle ili\u015Fkili iki halka olarak uygulan\u0131r:
      harici sabit alfabetik halka ve saat y\xF6n\xFCnde belirli bir k anahtar\u0131
      ile d\xF6nd\xFCr\xFClebilen dahili halka. \u015Eifresini \xE7\xF6zerken d\u0131\u015F
      halkan\u0131n her harfi \u015Fifreli harfle kar\u015F\u0131l\u0131k gelir."
    Object: {fileID: 0}
  - Language: English
    Text: 'The Caesar cipher is implemented as two interconnected rings: an outer
      fixed alphabet ring and an inner ring that can be rotated clockwise by a given
      key k. When deciphering, each letter of the outer ring corresponds to an encrypted
      letter.'
    Object: {fileID: 0}
