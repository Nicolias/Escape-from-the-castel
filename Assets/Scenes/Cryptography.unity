--- !u!114 &1100831617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1100831613}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbf51be86e70d7941bd40914206e4ddc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  translationName: Atbash Discriptoin
  FallbackText: "\u0428\u0438\u0444\u0440 \u0410\u0442\u0431\u0430\u0448 \u2014 \u044D\u0442\u043E
    \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044F\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0437\u0430\u043C\u0435\u043D\u044B,
    \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u0430\u044F \u0431\u0443\u043A\u0432\u0430
    \u0430\u043B\u0444\u0430\u0432\u0438\u0442\u0430 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0443\u044E:
    \xAB\u0410\xBB \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \xAB\u042F\xBB 
    \u0438 \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u0435; \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043F\u0440\u0438 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442
    \u0438\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0437\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u043E \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B \u0430\u043B\u0444\u0430\u0432\u0438\u0442\u0430.
    \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u0441\u0434\u0432\u0438\u0433\u043E\u0432\u044B\u0445
    \u0448\u0438\u0444\u0440\u043E\u0432, \u0410\u0442\u0431\u0430\u0448 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u0437\u0430\u043C\u0435\u043D\u044B
    \u0431\u0435\u0437 \u043A\u043B\u044E\u0447\u0430, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
    \u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u044B\u043C \u0434\u043B\u044F
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F, \u043D\u043E \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043A\u0440\u0430\u0439\u043D\u0435 \u0443\u044F\u0437\u0432\u0438\u043C\u044B\u043C
    \u043A \u0434\u0435\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435, \u0442\u0430\u043A
    \u043A\u0430\u043A \u043A\u0430\u0436\u0434\u0430\u044F \u0431\u0443\u043A\u0432\u0430
    \u0438\u043C\u0435\u0435\u0442 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
    \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442."
