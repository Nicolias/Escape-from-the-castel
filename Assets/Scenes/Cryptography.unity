  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1) \u041F\u043E\u043B\u0435 \u0434\u043B\u044F \u043F\u043E\u043A\u0430\u0437\u0430
    \u0437\u0430\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0432\u0441\u0435\u0445 \u0448\u0438\u0444\u0440\u043E\u0432.\n\n2) \u0423 \u0438\u0433\u0440\u043E\u043A\u0430
    \u0435\u0441\u0442\u044C \u0442\u0440\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    \u043D\u0430 \u043E\u0442\u0432\u0435\u0442. \u0415\u0441\u043B\u0438 \u0438\u0433\u0440\u043E\u043A
    \u043E\u0448\u0438\u0431\u0441\u044F \u0442\u0440\u0438 \u0440\u0430\u0437\u0430
    - \u0438\u0433\u0440\u0430 \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u0430.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3e098393af9edab469e946357b5d179e, type: 2}
