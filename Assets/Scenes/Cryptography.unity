  m_Script: {fileID: 11500000, guid: dbf51be86e70d7941bd40914206e4ddc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  translationName: Tutorial Description 2
  FallbackText: "1) \u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
    \u0434\u043B\u044F \u0434\u0435\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438.\n\n2)
    \u0421\u0442\u0440\u043E\u043A\u0430 \u0441 \u0437\u0430\u043A\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u0435\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C.\n\n3)
    \u0414\u043B\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0448\u0438\u0444\u0440\u043E\u0432
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C \u043A\u043B\u044E\u0447,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u044D\u0442\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0435.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
