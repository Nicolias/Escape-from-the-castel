  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vigenere \u015Fifresi, her bir a\xE7\u0131k metin karakterinin, mesaj\u0131n
    uzunlu\u011Fu boyunca tekrarlanan anahtar kelimenin (veya ifadenin) bir sonraki
    karakterine kar\u015F\u0131l\u0131k gelen bir miktar kadar kayd\u0131r\u0131ld\u0131\u011F\u0131,
    blok simetrik bir ikame \u015Fifresidir; bu, de\u011Fi\u015Fken anahtarl\u0131
    bir Sezar tablosunun uygulanmas\u0131na e\u015Fde\u011Ferdir. Anahtar\u0131n
    t\xFCm metin i\xE7in sabit olmamas\u0131, ancak periyodik olarak tekrarlanmas\u0131
    nedeniyle, \u015Fifre frekans analizini b\xFCy\xFCk \xF6l\xE7\xFCde karma\u015F\u0131kla\u015Ft\u0131r\u0131r
    ve dilin istatistiksel \xF6zelliklerini gizlemeyi m\xFCmk\xFCn k\u0131lar, ancak
    anahtar yeterince uzun olmasa da yine de Kassi sald\u0131r\u0131s\u0131na (Kasiski)
    veya yinelenen bloklar\u0131 analiz etme y\xF6ntemlerine tabidir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3e098393af9edab469e946357b5d179e, type: 2}
  m_sharedMaterial: {fileID: -1395115416457440828, guid: 3e098393af9edab469e946357b5d179e, type: 2}
