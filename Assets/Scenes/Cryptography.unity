  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Atbash cipher is a one-way substitution system where each letter of
    the alphabet is replaced by its opposite: "A" becomes "Z", and so on; as a result,
    the original text is mirrored relative to the middle of the alphabet when encrypted.
    Unlike shift ciphers, Atbash uses a fixed substitution rule without a key, making
    it easy to implement but highly vulnerable to decryption, as each letter has
    a unique equivalent.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3e098393af9edab469e946357b5d179e, type: 2}
  m_sharedMaterial: {fileID: -1395115416457440828, guid: 3e098393af9edab469e946357b5d179e, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
