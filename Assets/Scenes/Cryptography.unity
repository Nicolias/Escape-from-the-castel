      m_Calls: []
  m_text: 'The Caesar cipher is implemented as two interconnected rings: an outer
    fixed alphabet ring and an inner ring that can be rotated clockwise by a given
    key k. When deciphering, each letter of the outer ring corresponds to an encrypted
    letter.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3e098393af9edab469e946357b5d179e, type: 2}
