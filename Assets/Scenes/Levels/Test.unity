  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: By changing the frequency and amplitude of the wave, you can achieve a
      match with the template.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041C\u0435\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u043E\u0442\u0443
      \u0438 \u0430\u043C\u043F\u043B\u0438\u0442\u0443\u0434\u0443 \u0432\u043E\u043B\u043D\u0443
      \u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u0441 \u0448\u0430\u0431\u043B\u043E\u043D\u043E\u043C. "
    Object: {fileID: 0}
  - Language: Turkish
    Text: "Frekans\u0131 ve genli\u011Fi de\u011Fi\u015Ftirerek dalgan\u0131n \u015Fablonla
      \xE7ak\u0131\u015Fmas\u0131n\u0131 sa\u011Flamak."
    Object: {fileID: 0}
