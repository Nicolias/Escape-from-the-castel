--- !u!114 &1503161766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1503161764}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "Find the required code in 4 attempts.\r\n\r\nRed digit \u2014 such a digit
      does not exist.\r\nOrange digit \u2014 the digit is not in the right place.\r\nGreen
      digit \u2014 it is in the right place."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u0439\u0442\u0438 \u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u043E\u0434
      \u0437\u0430 4 \u043F\u043E\u043F\u044B\u0442\u043A\u0438.\n\n\u041A\u0440\u0430\u0441\u043D\u0430\u044F
      \u0446\u0438\u0444\u0440\u0430 - \u0442\u0430\u043A\u043E\u0439 \u0446\u0438\u0444\u0440\u044B
      \u043D\u0435\u0442.\n\u041E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F
      \u0446\u0438\u0444\u0440\u0430 - \u0446\u0438\u0444\u0440\u0430 \u043D\u0435
      \u043D\u0430 \u0441\u0432\u043E\u0435\u043C \u043C\u0435\u0441\u0442\u0435.\n\u0417\u0435\u043B\u0435\u043D\u0430\u044F
      \u0446\u0438\u0444\u0440\u0430 - \u043E\u043D\u0430 \u043D\u0430 \u0441\u0432\u043E\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435."
    Object: {fileID: 0}
  - Language: Turkish
    Text: "\u0130stenilen kodu 4 denemede bulun.\r\n\r\nK\u0131rm\u0131z\u0131 rakam
      - b\xF6yle bir rakam yok.\r\nTuruncu rakam - rakam yerinde de\u011Fil.\r\nYe\u015Fil
      rakam - yerinde."
    Object: {fileID: 0}
